# ========================================
# SUPABASE CONFIGURATION
# ========================================

# URL del proyecto Supabase
SUPABASE_URL=https://your-project.supabase.co

# API Key anónima (lectura pública)
SUPABASE_ANON_KEY=your-anon-key-here

# API Key de service role (admin)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ========================================
# SERVER CONFIGURATION
# ========================================

# Puerto donde corre el servidor
PORT=3000

# Ambiente (development, production)
NODE_ENV=development

# ========================================
# NGROK CONFIGURATION (Opcional)
# ========================================

# Token de ngrok para autenticación
NGROK_AUTH_TOKEN=your-ngrok-token-here

# ========================================
# CÓMO OBTENER LAS CREDENCIALES
# ========================================

# 1. Ir a https://supabase.com
# 2. Crear nueva cuenta y proyecto
# 3. En Settings > API, copiar:
#    - SUPABASE_URL
#    - SUPABASE_ANON_KEY (public anon key)
#    - SUPABASE_SERVICE_KEY (service_role key)
# 4. Para ngrok: https://dashboard.ngrok.com/auth/your-authtoken
